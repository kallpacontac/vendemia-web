# ══════════════════════════════════════════════════════════════════════════
# VARIABLES DE ENTORNO · copia este fichero a .env.local y rellena los valores
# ══════════════════════════════════════════════════════════════════════════
#
#   cp .env.example .env.local
#
# .env.local está en .gitignore y no se sube nunca. En Vercel estas mismas
# variables van en Settings › Environment Variables (Production, Preview y
# Development), y hay que volver a desplegar para que entren: NEXT_PUBLIC_* se
# incrusta en el bundle al construir, no se lee en caliente.

# ── Supabase ──────────────────────────────────────────────────────────────
# Las dos salen de Supabase › Project Settings › API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# ⚠️ LA CLAVE ANON (sb_publishable_… / "anon public"), NUNCA la service_role.
#
# La anon viaja al navegador a propósito: respeta RLS y sin sesión no devuelve
# ni una fila de negocio. La service_role (sb_secret_…) se salta el RLS entero
# — con ella en el bundle, cualquiera lee y escribe TODAS las compañías. Esa
# clave es solo del bot: no va aquí, ni en Vercel, ni en el repo.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Dominio público ───────────────────────────────────────────────────────
# Sin esto, la imagen de Open Graph se resuelve contra localhost:3000 y la
# previsualización sale rota en WhatsApp y en LinkedIn.
NEXT_PUBLIC_SITE_URL=https://vendemias.com

# ── Cloudinary · las fotos del catálogo ───────────────────────────────────
# ⚠️ SIN `NEXT_PUBLIC_`, Y NO ES UN DESCUIDO.
#
# Estas tres solo las lee el servidor, en app/api/cloudinary/firma/route.ts.
# Con el prefijo NEXT_PUBLIC_ acabarían en el bundle, y el api_secret en el
# bundle es una cuenta de Cloudinary abierta: cualquiera que lea el JavaScript
# sube lo que quiera. Si alguna vez el panel dice que "faltan las claves de
# Cloudinary", la solución NO es ponerles el prefijo.
#
# Salen del panel de Cloudinary › Settings › API Keys. Álvaro las tiene en el
# .env del bot, que usa las mismas.
CLOUDINARY_CLOUD_NAME=xxxxxxxx
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Medición de anuncios ──────────────────────────────────────────────────
#
# ID del píxel de Meta (Administrador de eventos → Orígenes de datos).
# Solo el número, sin comillas. Ejemplo: 1234567890123456
#
# ⚠️ DÉJALA VACÍA EN LOCAL. Sin ella no se carga el píxel y no se manda ni un
# evento: es justo lo que quieres mientras programas. Cada recarga tuya medida
# le enseña a Meta a buscar gente parecida a ti, que es lo contrario de lo que
# estás comprando.
#
# Ponla solo en las variables de entorno de producción.
NEXT_PUBLIC_META_PIXEL_ID=

# ══════════════════════════════════════════════════════════════════════════
# VENDEMIA FIDELIZA · ver modules/fideliza/sql/README.md
# ══════════════════════════════════════════════════════════════════════════
# Todo lo de abajo es SOLO de servidor salvo NEXT_PUBLIC_FIDELIZA_URL.
# ⚠️ Ninguna clave lleva NEXT_PUBLIC_: con el prefijo acabaría en el bundle.

# Host de las placas, tarjetas y páginas públicas. Lo que se graba en el chip.
# En local: http://localhost:3000 (el middleware no separa hosts).
NEXT_PUBLIC_FIDELIZA_URL=https://fideliza.vendemias.com

# Abre las funciones loyalty_srv_* de Postgres (páginas públicas y worker).
# En la base solo va su SHA-256 (ver modules/fideliza/sql/0006_grants.sql).
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FIDELIZA_SERVER_KEY=

# Google Wallet. El emisor y la clase de demo no son secretos; las credenciales SÍ.
GOOGLE_WALLET_ISSUER_ID=3388000000023213846
GOOGLE_WALLET_DEMO_CLASS_ID=3388000000023213846.vendemia_fideliza_v1
# El JSON de la service account, en base64 (base64 -w0 clave.json). NUNCA en el repo.
GOOGLE_WALLET_CREDENTIALS_JSON_BASE64=
GOOGLE_WALLET_PROGRAM_LOGO_URL=https://vendemias.com/wallet/logo-vendemia-1024.png
# demo = el emisor sigue en revisión: el botón avisa de que solo vale con cuentas de prueba.
GOOGLE_WALLET_MODE=demo

# Vercel Cron manda Authorization: Bearer <CRON_SECRET>. Mínimo 16 caracteres.
CRON_SECRET=

# Web Push. Genera el par con: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:contacto@vendemias.com

# Buscar el negocio en Google para armar solos los enlaces de reseñas y mapa.
# Clave de Places API (New), restringida a esa API. Solo servidor.
GOOGLE_PLACES_API_KEY=
